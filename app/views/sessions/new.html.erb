<% field_classes = "mt-2 block w-full rounded-2xl border border-stone-300 bg-white px-4 py-3 text-sm text-stone-900 shadow-sm outline-none transition focus:border-ochre-500 focus:ring-4 focus:ring-ochre-200" %>
<% google_oauth_enabled = ENV["GOOGLE_CLIENT_ID"].present? && ENV["GOOGLE_CLIENT_SECRET"].present? %>

<section class="mx-auto max-w-md px-2 py-10 sm:px-0">
  <div class="rounded-[2rem] border border-stone-200 bg-white p-6 shadow-lg shadow-stone-200/70 sm:p-8">
    <h1 class="text-center text-3xl font-semibold tracking-tight text-stone-900">ログイン</h1>
    <p class="mt-3 text-center text-sm leading-6 text-stone-600">
      メールアドレスとパスワード、または Google アカウントでログインできます。
    </p>

    <%= form_with url: login_path, local: true do |f| %>
      <div class="mt-8 space-y-5">
        <div>
          <%= f.label :email, "メールアドレス", class: "text-sm font-medium text-stone-700" %>
          <%= f.email_field :email, class: field_classes %>
        </div>

        <div>
          <%= f.label :password, "パスワード", class: "text-sm font-medium text-stone-700" %>
          <%= f.password_field :password, class: field_classes %>
        </div>
      </div>

      <div class="mt-3 text-right text-sm">
        <%= link_to "パスワードを忘れた方はこちら", new_password_path, class: "font-medium text-ochre-700 transition hover:text-ochre-500" %>
      </div>

      <div class="mt-8">
        <%= f.submit "ログイン", class: "inline-flex w-full items-center justify-center rounded-full bg-stone-900 px-5 py-3 text-sm font-semibold text-white transition hover:bg-stone-700" %>
      </div>
    <% end %>

    <% if google_oauth_enabled %>
      <div class="relative my-6">
        <div class="absolute inset-0 flex items-center" aria-hidden="true">
          <div class="w-full border-t border-stone-200"></div>
        </div>
        <div class="relative flex justify-center">
          <span class="bg-white px-4 text-xs font-semibold uppercase tracking-[0.24em] text-stone-400">or</span>
        </div>
      </div>

      <%= link_to "/auth/google_oauth2",
          data: { turbo: false },
          class: "flex w-full items-center justify-center rounded-2xl border border-stone-300 bg-white px-4 py-3 text-sm font-semibold text-stone-700 shadow-sm transition hover:border-stone-400 hover:bg-stone-50" do %>
        <span class="flex items-center gap-3">
          <%= image_tag "google-mark.svg", alt: "", class: "h-[18px] w-[18px] shrink-0" %>
          <span>Googleでログイン</span>
        </span>
      <% end %>
    <% end %>

    <div class="mt-6 text-center text-sm text-stone-600">
      <%= link_to "新規登録はこちら", new_user_path, class: "font-medium text-ochre-700 transition hover:text-ochre-500" %>
    </div>
  </div>
</section>
